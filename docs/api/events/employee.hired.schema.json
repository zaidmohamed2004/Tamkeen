{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zaidmohamed2004/Tamkeen/docs/api/events/employee.hired.schema.json",
  "title": "employee.hired",
  "description": "A candidate was hired. Consumer: Quota Module (asks Consent Module isVerifiedPwd), Audit Module. Carries no disability data.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "employee.hired"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "Applications Module"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "companyId",
        "seekerUid",
        "startDate"
      ],
      "properties": {
        "applicationId": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "seekerUid": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}